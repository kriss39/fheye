{
  "name": "fheye",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "fheye": "dist-cli/fheye.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "tsx cli/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "description": "Browser-only inspector for Fhenix CoFHE: FHE task graphs, handle decoding, leak detection and mainnet TaskManager status"
}
